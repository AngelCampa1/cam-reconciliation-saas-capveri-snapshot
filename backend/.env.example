# Supabase Configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs
# Annual-only workflow-maturity self-serve pricing (current model).
STRIPE_PRICE_ID_RECONCILE_ANNUAL=price_reconcile_annual
STRIPE_PRODUCT_ID_RECONCILE=prod_reconcile

# Legacy annual Growth tier IDs remain for grandfathered subscriptions; new
# self-serve pricing uses Reconcile, Control, and Defend annual packages.
STRIPE_PRICE_ID_GROWTH_BASE_ANNUAL=price_growth_base_annual
STRIPE_PRICE_ID_UNIT_OVERAGE_ANNUAL=price_unit_overage_annual
# Deprecated legacy growth alias — kept for webhook backward compat
STRIPE_PRICE_ID_GROWTH_ANNUAL=price_your_growth_annual_id


# Stripe Save Offer Coupons
# Pre-create in Stripe as 20% off, duration=once (next annual renewal invoice only)
STRIPE_SAVE_OFFER_COUPON_ID_ANNUAL=SAVE20_1INV_ANNUAL
# Free-audit follow-up offers
STRIPE_FREE_AUDIT_COUPON_OFFER_50=FREEAUDIT50_ANNUAL
STRIPE_FREE_AUDIT_COUPON_OFFER_FREE=FREEAUDIT100_ANNUAL
# Limited checkout offer coupon (80% off once, 300 redemptions)
STRIPE_80OFF_COUPON_ID=80OFF
# HMAC secret for signed checkout offer tokens
CHECKOUT_OFFER_TOKEN_SECRET=replace-with-strong-secret
# Secret used by the daily winback processor endpoint
FREE_AUDIT_WINBACK_CRON_SECRET=replace-with-strong-secret

# Cloudflare R2 document storage (tenant PDF uploads)
DOCUMENTS_R2_BUCKET=capveri-documents
DOCUMENTS_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
DOCUMENTS_R2_ACCESS_KEY_ID=your_r2_access_key_id
DOCUMENTS_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
DOCUMENTS_R2_REGION=auto

# Cloudflare R2 lead-magnet asset storage (shares credentials with documents bucket)
LEAD_MAGNETS_R2_BUCKET=capveri-lead-magnets

# OpenRouter API — every LLM call (extraction, judge, classification, analysis)
# routes through OpenRouter. No direct Anthropic / OpenAI clients are used.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Dual-extract: primary native-PDF extraction (Gemini 3.1 Flash Lite)
EXTRACTION_PRIMARY_MODEL=google/gemini-3.1-flash-lite-preview
EXTRACTION_PRIMARY_FALLBACK=moonshotai/kimi-k2.6
EXTRACTION_PRIMARY_FALLBACK_2=openai/gpt-5.4-mini

# Dual-extract: sibling native-PDF extraction (Gemini 3 Flash for diversity)
EXTRACTION_SIBLING_MODEL=google/gemini-3-flash-preview
EXTRACTION_SIBLING_FALLBACK=openai/gpt-5.4-mini
EXTRACTION_SIBLING_FALLBACK_2=moonshotai/kimi-k2.6

# Dual-extract: judge (arbitrates every disagreement; text-only)
EXTRACTION_JUDGE_MODEL=z-ai/glm-5.1
EXTRACTION_JUDGE_FALLBACK=openai/gpt-5.4-mini
EXTRACTION_JUDGE_FALLBACK_2=moonshotai/kimi-k2.6

# Gap-filler: on-demand re-extract of missing critical fields (multimodal)
GAP_FILLER_MODEL=google/gemini-3-flash-preview
GAP_FILLER_FALLBACK=moonshotai/kimi-k2.6
GAP_FILLER_FALLBACK_2=openai/gpt-5.4-mini

# Cross-doc reconciliation (lease ↔ statement, text-only)
CROSS_DOC_MODEL=z-ai/glm-5.1
CROSS_DOC_FALLBACK=openai/gpt-5.4-mini
CROSS_DOC_FALLBACK_2=moonshotai/kimi-k2.6

# GL anomaly analysis (text-only)
GL_ANALYSIS_MODEL=z-ai/glm-5.1
GL_ANALYSIS_FALLBACK=openai/gpt-5.4-mini
GL_ANALYSIS_FALLBACK_2=moonshotai/kimi-k2.6

# Pool matching (cheap classification, text-only)
POOL_MATCHING_MODEL=moonshotai/kimi-k2.6
POOL_MATCHING_FALLBACK=openai/gpt-5.4-mini
POOL_MATCHING_FALLBACK_2=google/gemini-3-flash-preview

EXTRACTION_MAX_DOCUMENT_CHARS=100000
DUAL_EXTRACT_ENABLED=true

# Celery / Redis (Background Extraction Queue)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_DEFAULT_QUEUE=extractions
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=600
CELERY_TASK_TIME_LIMIT_SECONDS=720

# Cloudflare Turnstile secret key for public-form bot protection.
# Unset outside production = verification bypassed (dev/test). Unset in
# production = fail closed (all public form posts rejected). Never commit a real value.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=capveri.com,www.capveri.com,app.capveri.com,localhost,127.0.0.1

# Resend (Email Service)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_ADDRESS=Angel Campa <angel.campa@capveri.com>
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
UNSUBSCRIBE_HMAC_SECRET=change-me-in-production
ADMIN_NOTIFICATION_EMAIL=angel.campa@capveri.com
# Optional; falls back to FREE_AUDIT_WINBACK_CRON_SECRET, RESEND_WEBHOOK_SECRET, then UNSUBSCRIBE_HMAC_SECRET.
SIGNUP_NURTURE_CRON_SECRET=replace-with-strong-secret

# AI SDR signed product context endpoint
AI_SDR_CONTEXT_SECRET=replace-with-platform-context-secret
AI_SDR_PRODUCT_CONTEXT_SECRET=replace-with-platform-context-secret
AI_CS_CONTEXT_SECRET=replace-with-platform-context-secret

# Apollo removed — nurture handled by Resend
# APOLLO_API_KEY=
# APOLLO_SEQUENCE_ID=
# APOLLO_EMAIL_ACCOUNT_ID=

# Sentry — Error Tracking & Performance Monitoring
# Leave empty to disable Sentry
SENTRY_DSN=

# PostHog - server-side Stripe lifecycle analytics
# Leave POSTHOG_PROJECT_API_KEY empty to disable backend capture locally.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
