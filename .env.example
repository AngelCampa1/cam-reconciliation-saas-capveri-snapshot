# CapVeri.com Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Supabase Configuration (Local Development)
# =============================================================================
# These values are for local development with `supabase start`
# For production, use your Supabase project dashboard values

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-start

# =============================================================================
# Database Connection
# =============================================================================
# Local development database URL (from `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# For direct database access (bypassing Supabase API)
# Useful for migrations and admin tasks
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# =============================================================================
# JWT Configuration
# =============================================================================
# JWT secret for local development (matches Supabase local config)
# In production, this is managed by Supabase
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Backend API URL
BACKEND_URL=http://localhost:8000

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# Enable debug mode
DEBUG=true

# Enable verbose logging
LOG_LEVEL=DEBUG

# PostHog backend capture (optional; leave empty locally)
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# External Services (Production Only)
# =============================================================================
# document reader (for OCR)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_TEXTRACT_BUCKET=capveri-documents

# LLM extraction runs through the OpenRouter gateway, not the Anthropic SDK.
# See backend/.env.example for OPENROUTER_API_KEY / OPENROUTER_BASE_URL.
# Model IDs are defined in backend/app/config.py.

# =============================================================================
# Stripe Configuration (Billing & Subscriptions)
# =============================================================================
# Get these from your Stripe Dashboard (https://dashboard.stripe.com)
# Use test keys (sk_test_/pk_test_) for development
# Use live keys (sk_live_/pk_live_) for production

# Stripe Secret Key (used for API calls)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# Stripe Publishable Key (used in frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Stripe Webhook Secret (for webhook signature verification)
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (from Stripe Dashboard > Products)
# These map to annual-only Reconcile pricing
STRIPE_PRICE_ID_RECONCILE_ANNUAL=price_reconcile_annual
STRIPE_PRODUCT_ID_RECONCILE=prod_reconcile

# Stripe Coupons
STRIPE_LAUNCH50_COUPON_ID=LAUNCH50

# =============================================================================
# OAuth Providers (Configured in Supabase Dashboard)
# =============================================================================
# OAuth credentials are configured directly in the Supabase Dashboard under
# Authentication > Providers. The values below are for documentation purposes.
# See docs/configuration/oauth-setup.md for detailed setup instructions.

# Google OAuth
# - Create at: https://console.cloud.google.com/apis/credentials
# - Enter Client ID and Client Secret in Supabase Dashboard > Authentication > Providers
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Apple Sign In
# - Create at: https://developer.apple.com/account/resources/identifiers
# - Enter all values in Supabase Dashboard > Authentication > Providers
# APPLE_SERVICE_ID=com.capveri.auth
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# OAuth Redirect URLs (Managed by Supabase)
# Supabase callback: https://<project-ref>.supabase.co/auth/v1/callback
# After auth, users are redirected to:
#   Local: http://localhost:5173/auth/callback
#   Staging: https://staging.capveri.com/auth/callback
#   Production: https://app.capveri.com/auth/callback

# =============================================================================
# Getting Started
# =============================================================================
# 1. Install Supabase CLI: https://supabase.com/docs/guides/cli
# 2. Run `supabase start` to launch local Supabase stack
# 3. Copy the anon key and service role key from the output
# 4. Fill in the values above
# 5. Access Studio at http://localhost:54323
