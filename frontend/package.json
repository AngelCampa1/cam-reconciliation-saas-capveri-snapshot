{
  "name": "capveri-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "build:cf": "node scripts/cloudflare-env-runner.mjs build",
    "preview": "vite preview",
    "preview:cf": "wrangler dev",
    "deploy:cf": "node scripts/cloudflare-env-runner.mjs deploy",
    "cf:dry-run": "node scripts/cloudflare-env-runner.mjs dry-run",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:fast": "vitest run --coverage --coverage.reporter=text",
    "test:coverage:ci": "vitest run --coverage",
    "test:coverage:debug": "vitest run --coverage --pool.threads.singleThread=true",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "generate-api-client": "tsx scripts/generate-api-client.ts",
    "generate-api-client:live": "tsx scripts/generate-api-client.ts --live",
    "generate-api-client:save": "tsx scripts/generate-api-client.ts --save",
    "generate-api-client:watch": "openapi-ts -f openapi-codegen.config.ts --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "tokens": "node ../style-dictionary.config.js",
    "plans:generate": "node ../scripts/generate-plan-tiers.mjs",
    "videos:generate": "node ../scripts/generate-videos.mjs",
    "funnel:check": "node ../scripts/funnel-coherence-gate.mjs"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.6.0",
    "@hookform/resolvers": "^5.2.2",
    "@posthog/react": "^1.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^8.0.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.14",
    "@ventora/ai-cs": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "^5.4.530",
    "posthog-js": "^1.375.0",
    "react": "^19",
    "react-dom": "^19",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.1.0",
    "@hey-api/openapi-ts": "0.97.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^25.0.0",
    "msw": "^2.12.7",
    "pdfkit": "^0.17.2",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.50.1",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "protobufjs": "7.6.1"
  }
}
