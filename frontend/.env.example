# API Configuration
VITE_API_URL=http://localhost:8000

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics - Google Tag Manager
# Set to your GTM container ID in production (e.g. GTM-XXXXXXX)
# Leave empty in development to disable GTM loading
# The inline script in index.html guards against unsubstituted %VITE_GTM_ID% placeholders
VITE_GTM_ID=

# Sentry — Error Tracking & Performance Monitoring
# Leave empty to disable Sentry
VITE_SENTRY_DSN=

# PostHog — Product Analytics, Session Replay, Heatmaps
# Defaults to the Capveri.com PostHog project when omitted.
VITE_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_PROJECT_KEY
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile — bot protection for public lead/audit/contact forms
# Public site key (safe to expose). Leave empty in local dev to disable the
# widget; when empty the backend skips verification outside production and fails
# closed in production. Must be set in production and deployed together with the
# backend TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Ventora CRM feedback widget (authenticated surface only). Leave key blank in the repo;
# set the real value in the deploy env. Without it the widget renders nothing.
VITE_CRM_WIDGET_KEY=
VITE_CRM_LOADER_URL=https://widgets.ventoralabs.com/w/v1.js

# AI-CS in-app help chat (authenticated surface only). Origin of the ai-cs-worker
# (no path suffix), e.g. https://ai-cs.ventoralabs.com. Leave blank in the repo;
# set the real value in the deploy env. Without it the help chat renders nothing.
VITE_AI_CS_BASE_URL=
