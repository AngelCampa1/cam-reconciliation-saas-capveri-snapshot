{
  "name": "capveri-marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build --webpack",
    "vercel-rollback-build": "node scripts/vercel-rollback-build.mjs",
    "build:cf": "node scripts/cloudflare-env-runner.mjs build",
    "preview:cf": "npx opennextjs-cloudflare preview",
    "deploy:cf": "node scripts/cloudflare-env-runner.mjs deploy",
    "cf:dry-run": "npm run build:cf && npx wrangler deploy --dry-run",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tokens": "node ../style-dictionary.config.js",
    "plans:generate": "node ../scripts/generate-plan-tiers.mjs",
    "videos:generate": "node ../scripts/generate-videos.mjs",
    "funnel:check": "node ../scripts/funnel-coherence-gate.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=mobile-iphone --project=mobile-android",
    "test:e2e:production:manual": "node scripts/run-production-e2e.mjs",
    "llms:generate": "node scripts/generate-llms.mjs",
    "llms:check": "node scripts/generate-llms.mjs --check",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "indexnow:dry": "node scripts/indexnow-submit.mjs --dry-run",
    "indexer:urls": "node scripts/export-prod-indexer-urls.mjs",
    "indexer:urls:check": "node scripts/export-prod-indexer-urls.mjs --check",
    "indexer:urls:net-new": "node scripts/export-prod-indexer-urls.mjs --net-new",
    "indexer:urls:net-new:check": "node scripts/export-prod-indexer-urls.mjs --net-new --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.50.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "light-theme-only": "npm:next-themes@^0.4.6",
    "lucide-react": "^0.469.0",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.375.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "postcss": "8.5.10",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "picomatch@^2.0.0": "2.3.2",
    "picomatch@^4.0.0": "4.0.4",
    "postcss": "8.5.10",
    "protobufjs": "7.6.1"
  }
}
