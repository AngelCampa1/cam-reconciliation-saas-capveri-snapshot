# CapVeri Marketing Site — Environment Variables
# Copy to .env.local and fill in values

# Backend API URL (required for contact form, feedback widget, calculators)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App frontend URL (required for CTA links, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Google Tag Manager (optional, leave blank to disable)
NEXT_PUBLIC_GTM_ID=

# Cloudflare Turnstile public site key for public-form bot protection.
# When unset, the marketing forms render without the challenge (dev bypass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics (optional, leave blank to disable)
NEXT_PUBLIC_GA_ID=

# PostHog — Product Analytics, Session Replay, Heatmaps
# Defaults to the Capveri.com PostHog project when omitted.
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_PROJECT_KEY
# Host defaults to https://us.i.posthog.com if unset; override for EU data residency
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking (optional, leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
