# Supabase local development files
# These are generated by `supabase start` and should not be committed

# Local Supabase data
.branches/
.temp/

# Generated types (regenerate with `supabase gen types typescript`)
# Uncomment if you want to version control generated types:
# types/

# Docker volumes (if using custom docker-compose)
volumes/

# Backup files
*.backup
*.dump

# Log files
*.log
